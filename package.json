{
  "name": "quota-pilot",
  "version": "0.1.0-alpha.5",
  "description": "Outbound API rate limiting, scheduling and retries for Node. Multi-constraint weighted token buckets with deterministic tests.",
  "keywords": [
    "rate-limit",
    "rate-limiter",
    "token-bucket",
    "throttle",
    "retry",
    "backoff",
    "exponential-backoff",
    "retry-after",
    "concurrency",
    "concurrency-limit",
    "queue",
    "scheduler",
    "quota",
    "api-client",
    "abortsignal",
    "typescript"
  ],
  "license": "MIT",
  "author": "Snir Yadid",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/REPLACE_ME_OWNER/quota-pilot.git"
  },
  "homepage": "https://github.com/REPLACE_ME_OWNER/quota-pilot#readme",
  "bugs": {
    "url": "https://github.com/REPLACE_ME_OWNER/quota-pilot/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "files": [
    "dist",
    "src",
    "docs/ARCHITECTURE.md",
    "docs/DECISIONS.md",
    "docs/GUARANTEES.md",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run clean && npm run build:esm && npm run build:cjs && node scripts/post-build.mjs",
    "build:esm": "tsc -p tsconfig.build.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "smoke": "node scripts/smoke.mjs",
    "preflight": "node scripts/preflight.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run smoke",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.5",
    "eslint-plugin-import-x": "^4.18.1",
    "fast-check": "^3.23.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^2.1.8"
  }
}
